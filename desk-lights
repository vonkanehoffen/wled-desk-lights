def controller_url(host):
    host = host.strip().rstrip("/")
    if not host:
        raise ValueError("the controller hostname cannot be empty")
    if not host.startswith(("http://", "https://")):
        host = f"http://{host}"
    return host


def set_state(host, command):
    request = Request(
        f"{controller_url(host)}/json/state",
        data=command.encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urlopen(request, timeout=3):
        pass


def main():
    parser = argparse.ArgumentParser(description="Set the desk lights state.")
    parser.add_argument("state", choices=API_COMMANDS)
    parser.add_argument(
        "--host",
        default=os.environ.get("DESK_LIGHTS_HOST", DEFAULT_HOST),
        help=f"WLED hostname or URL (default: $DESK_LIGHTS_HOST or {DEFAULT_HOST})",
    )
    args = parser.parse_args()

    command = API_COMMANDS[args.state]
    try:
        json.loads(command)  # Catch mistakes in newly pasted command blocks.
        set_state(args.host, command)
    except json.JSONDecodeError as error:
        print(f"desk-lights: invalid API command for {args.state}: {error}", file=sys.stderr)
        return 1
    except HTTPError as error:
        print(f"desk-lights: controller returned HTTP {error.code}", file=sys.stderr)
        return 1
    except (URLError, TimeoutError, ValueError) as error:
        reason = getattr(error, "reason", error)
        print(f"desk-lights: could not reach {args.host}: {reason}", file=sys.stderr)
        return 1

    print(f"Desk lights: {args.state}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
