#!/usr/bin/env python3
"""Small, dependency-free CLI for the desk WLED controller."""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


DEFAULT_HOST = "wled-desk.local"
COLORS = {
    "pink": [255, 20, 147],
    "blue": [0, 122, 255],
}


class WLEDError(RuntimeError):
    """Raised when the WLED controller cannot complete a request."""


def controller_url(host: str) -> str:
    host = host.strip().rstrip("/")
    if not host:
        raise WLEDError("the controller hostname cannot be empty")
    if not host.startswith(("http://", "https://")):
        host = f"http://{host}"
    return host


def request_json(host: str, path: str, payload: dict[str, Any] | None = None) -> Any:
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    request = Request(
        f"{controller_url(host)}{path}",
        data=data,
        headers={"Content-Type": "application/json"},
        method="GET" if data is None else "POST",
    )
    try:
        with urlopen(request, timeout=3) as response:
            return json.load(response)
    except HTTPError as error:
        raise WLEDError(f"controller returned HTTP {error.code}") from error
    except URLError as error:
        reason = getattr(error, "reason", error)
        raise WLEDError(f"could not reach {host}: {reason}") from error
    except (json.JSONDecodeError, TimeoutError) as error:
        raise WLEDError(f"invalid or timed-out response from {host}") from error


def state_payload(action: str, brightness: int | None) -> dict[str, Any]:
    payload: dict[str, Any]
    if action in COLORS:
        payload = {
            "on": True,
            "seg": [{"id": 0, "fx": 0, "col": [COLORS[action]]}],
        }
    elif action == "pulse":
        # WLED effect 2 is Breathe. Omitting `col` keeps the current colour.
        payload = {"on": True, "seg": [{"id": 0, "fx": 2}]}
    elif action == "on":
        payload = {"on": True}
    elif action == "off":
        payload = {"on": False}
    else:
        raise ValueError(f"unsupported action: {action}")

    if brightness is not None and action != "off":
        payload["bri"] = brightness
    return payload


def describe_state(state: dict[str, Any]) -> str:
    power = "on" if state.get("on") else "off"
    brightness = state.get("bri", "unknown")
    segments = state.get("seg") or []
    effect = segments[0].get("fx") if segments else None
    suffix = f", effect {effect}" if effect is not None else ""
    return f"Desk lights: {power}, brightness {brightness}{suffix}"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="desk-lights",
        description="Control the WLED-powered desk lights.",
    )
    result.add_argument(
        "action",
        choices=[*COLORS, "pulse", "on", "off", "status"],
        help="colour, effect, power action, or status",
    )
    result.add_argument(
        "--host",
        default=os.environ.get("DESK_LIGHTS_HOST", DEFAULT_HOST),
        help=f"WLED hostname or URL (default: $DESK_LIGHTS_HOST or {DEFAULT_HOST})",
    )
    result.add_argument(
        "--brightness",
        "-b",
        type=int,
        choices=range(1, 256),
        metavar="1-255",
        help="set brightness while applying the action",
    )
    return result


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.action == "status":
            print(describe_state(request_json(args.host, "/json/state")))
            return 0

        request_json(args.host, "/json/state", state_payload(args.action, args.brightness))
        detail = f" at brightness {args.brightness}" if args.brightness else ""
        print(f"Desk lights: {args.action}{detail}")
        return 0
    except WLEDError as error:
        print(f"desk-lights: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
